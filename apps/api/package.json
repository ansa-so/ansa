{
	"name": "@ansa/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"type-check": "tsc --noEmit",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"seed:marketplace": "tsx scripts/seed-marketplace.ts",
		"seed:triggers": "tsx scripts/seed-triggers.ts",
		"seed:screenshots": "tsx scripts/seed-screenshot-account.ts",
		"email:dev": "email dev -d emails"
	},
	"dependencies": {
		"@ansa/db": "workspace:*",
		"@ansa/types": "workspace:*",
		"@ansa/utils": "workspace:*",
		"@anthropic-ai/sdk": "^0.117.1",
		"@hono/node-server": "^2.1.1",
		"@react-email/components": "^1.0.12",
		"@types/marked": "^6.0.0",
		"better-auth": "^1.7.1",
		"dotenv": "^17.4.2",
		"franc": "^6.2.0",
		"hono": "^4.13.3",
		"mammoth": "^1.12.1",
		"marked": "^17.0.1",
		"node-cron": "^4.6.0",
		"posthog-node": "^5.49.1",
		"react": "^19.2.8",
		"react-dom": "19.2.8",
		"resend": "^6.20.0",
		"sharp": "^0.35.3",
		"socket.io": "^4.8.3",
		"stripe": "^17.7.0",
		"unpdf": "^1.8.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@types/node": "^26.2.0",
		"@types/node-cron": "^3.0.11",
		"@types/react": "^19.2.18",
		"@vitest/coverage-v8": "^4.1.11",
		"react-email": "^6.9.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}

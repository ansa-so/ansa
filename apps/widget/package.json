{
	"name": "@ansa/widget",
	"version": "0.2.9",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 3002",
		"build": "vite build && vite build --config vite.embed.config.ts",
		"build:embed": "vite build --config vite.embed.config.ts",
		"release": "pnpm build:embed && cp dist/embed.js ./embed.js && npx wrangler r2 object put ansa/embed.js --file dist/embed.js --content-type 'application/javascript; charset=utf-8' --cache-control 'public, max-age=3600' --remote && pnpm purge-cdn",
		"purge-cdn": "dotenv -e ../../.env -- sh -c 'curl -X POST \"https://api.cloudflare.com/client/v4/zones/$CLOUDFLARE_ZONE_ID/purge_cache\" -H \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\" -H \"Content-Type: application/json\" --data \"{\\\"hosts\\\":[\\\"cdn.ansa.so\\\"]}\"'",
		"preview": "vite preview",
		"lint": "biome check src",
		"lint:fix": "biome check --write src"
	},
	"dependencies": {
		"@ansa/types": "workspace:*",
		"@ansa/utils": "workspace:*",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"socket.io-client": "^4.8.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"autoprefixer": "^10.6.1",
		"dotenv-cli": "^8.0.0",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.7.2",
		"vite": "^8.3.0",
		"wrangler": "^4.136.1"
	}
}

# ansa Configuration
# Copy this file to .env and modify as needed

# ===================
# Core Settings
# ===================
NODE_ENV=development

# Set to true for self-hosted (disables billing/usage limits)
SELF_HOSTED=true

# REQUIRED. The API refuses to start without a real value of 32+ characters.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ===================
# Database
# ===================
# PostgreSQL credentials (Docker Compose auto-generates DATABASE_URL from these)
POSTGRES_USER=ansa
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ansa

# Only needed for local development without Docker:
# DATABASE_URL=postgresql://ansa:postgres@localhost:5432/ansa
# UPLOADS_DIR=./uploads/attachments

# ===================
# LLM Providers
# ===================
# Set one or more API keys to enable those providers.
# The model dropdown in Agent Settings will show all available models.

# Default model for new agents (defaults to gpt-4o-mini)
# DEFAULT_MODEL=gpt-4o-mini

# Optional quality-tier overrides
# MODEL_FAST=gpt-4o-mini
# MODEL_BALANCED=gpt-4o
# MODEL_HIGH_QUALITY=claude-sonnet-4-20250514

# Anthropic (Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI (GPT and o-series models)
# OPENAI_API_KEY=sk-your-key

# Google (Gemini models)
# GOOGLE_API_KEY=your-google-api-key

# Ollama (local development; use http://ollama:11434/v1 with Docker Compose)
# OLLAMA_API_BASE=http://localhost:11434/v1

# ===================
# Embeddings
# ===================
# Uses OpenAI text-embedding-3-small by default (requires OPENAI_API_KEY)
# For self-hosted with Ollama, embeddings use nomic-embed-text

# ===================
# URLs
# ===================
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:3001
WIDGET_URL=http://localhost:3002
CDN_URL=http://localhost:3002
DOCS_URL=https://docs.ansa.so
# PROJECT_NAME=Ansa

# ===================
# Dashboard Widget (Optional)
# ===================
# Load the Ansa widget on the dashboard itself (for support/help)
# DASHBOARD_AGENT_ID=your-agent-id

# ===================
# Emails
# ===================
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM=Ansa <noreply@ansa.so>

# Email Channel (for AI agent email responses)
# EMAIL_INBOUND_DOMAIN=mail.ansa.so
# RESEND_WEBHOOK_SECRET=whsec_xxxxx  # Optional: verify webhook signatures

# ===================
# OAuth (Optional)
# ===================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ===================
# Shopify Integration (Optional)
# ===================
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_SCOPES=read_orders,write_orders,read_customers,write_script_tags,read_products

# ===================
# Facebook Messenger Integration (Optional)
# ===================
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ===================
# Stripe Billing (Optional - not needed for self-hosted)
# ===================
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Price IDs - create with: npx tsx scripts/create-stripe-prices.ts
# Monthly prices
# STRIPE_PRICE_STARTER_MONTHLY=price_xxxxx
# STRIPE_PRICE_GROWTH_MONTHLY=price_xxxxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxxxx

# Yearly prices (2 months free)
# STRIPE_PRICE_STARTER_YEARLY=price_xxxxx
# STRIPE_PRICE_GROWTH_YEARLY=price_xxxxx
# STRIPE_PRICE_PRO_YEARLY=price_xxxxx

# ===================
# Local Demo Data (Optional)
# ===================
# Used by `pnpm --filter @ansa/api seed:screenshots` and `pnpm docs:screenshots`.
# The seed script creates a real, loginable account and refuses to run against a
# non-local DATABASE_URL. There are deliberately no defaults.
# SCREENSHOT_EMAIL=demo@localhost
# SCREENSHOT_PASSWORD=
# TEST_EMAIL=demo@localhost
# TEST_PASSWORD=

# ===================
# Analytics (Optional)
# ===================
# PostHog - Product analytics and session recording
# Get your Project API Key from https://posthog.com → Project Settings → Project API Key
# POSTHOG_KEY=phc_xxxxx  # Client-side dashboard key
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_KEY=phc_xxxxx  # Server-side (API) - use the SAME Project API Key as above

# ===================
# Request Blocking (Optional)
# ===================
# Comma-separated. Keep incident-specific values here rather than in source: a
# public repo would otherwise tell an attacker exactly what is filtered.
# PROXY_BLOCKED_IPS=203.0.113.4,198.51.100.9
# PROXY_BLOCKED_PATTERNS=some-payload\.sh,another-marker

# ===================
# Cloudflare (Optional)
# ===================
# Used to purge CDN cache when releasing widget updates
# CLOUDFLARE_ZONE_ID=your-zone-id
# CLOUDFLARE_API_TOKEN=your-api-token

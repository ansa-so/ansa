{
	"name": "@ansa-so/sdk",
	"version": "0.1.0",
	"description": "JavaScript SDK for Ansa AI agents",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts",
		"dev": "tsup src/index.ts --format cjs,esm --dts --watch",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"ansa",
		"ai",
		"chatbot",
		"agents",
		"conversational-ai",
		"sdk"
	],
	"author": "Ansa",
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^7.0.2"
	}
}

{
	"name": "@ansa/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./markdown-editor": {
			"import": "./dist/markdown-editor.js",
			"types": "./dist/markdown-editor.d.ts"
		},
		"./markdown-editor.css": "./dist/markdown-editor.css"
	},
	"scripts": {
		"build": "tsup src/index.tsx src/markdown-editor.tsx --format esm --dts --external react && cp src/markdown-editor.css dist/",
		"dev": "tsup src/index.tsx src/markdown-editor.tsx --format esm --dts --external react --watch",
		"type-check": "tsc --noEmit",
		"lint": "biome check src",
		"lint:fix": "biome check --write src"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@tiptap/extension-link": "^2.11.5",
		"@tiptap/extension-placeholder": "^2.11.5",
		"@tiptap/pm": "^2.11.5",
		"@tiptap/react": "^2.11.5",
		"@tiptap/starter-kit": "^3.30.3",
		"tiptap-markdown": "^0.9.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"react": "^19.2.8",
		"tsup": "^8.5.1",
		"typescript": "^5.7.2"
	}
}
